{
  "name": "sam-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --open",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "google": "node bin/google/index.js"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.2",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.6.4",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/zen-kaku-gothic-antique": "^5.3.0",
    "archieml": "^0.5.0",
    "googleapis": "^183.0.0",
    "marked": "^18.0.14"
  }
}
